# =====================================================================
# Django 后端配置
# =====================================================================

# 指定 Django 使用的 settings 模块（开发环境）
DJANGO_SETTINGS_MODULE=config.settings.development

# Django 密钥，用于加密签名等。请替换为随机值，可用以下命令生成：
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-random-value

# 是否开启调试模式。生产环境必须设为 False
DJANGO_DEBUG=True

# 允许访问的域名/IP 列表（逗号分隔）
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# 允许跨域访问的前端来源（CORS，逗号分隔）
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 允许的 CSRF 可信来源（逗号分隔）
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 以下为 HTTPS 安全相关配置，本地开发默认关闭，生产环境需按需开启
# 是否强制跳转 HTTPS
DJANGO_SECURE_SSL_REDIRECT=False

# 是否使用安全 Cookie（仅 HTTPS 下生效）
DJANGO_SECURE_COOKIES=False

# HSTS 有效期（秒），0 表示关闭
DJANGO_SECURE_HSTS_SECONDS=0

# HSTS 是否包含子域名
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# HSTS 是否加入浏览器预加载列表
DJANGO_SECURE_HSTS_PRELOAD=False

# =====================================================================
# MySQL 数据库配置
# 本地虚拟环境使用 127.0.0.1:3307；Docker 容器内会覆盖为 db:3306
# =====================================================================

# 数据库名
MYSQL_DATABASE=song_blog

# 测试数据库名
MYSQL_TEST_DATABASE=song_blog_test

# 应用连接用户
MYSQL_USER=song_blog_app

# 应用连接密码（请替换为随机强密码）
MYSQL_PASSWORD=replace-with-a-long-random-password

# MySQL root 密码（请替换为另一个随机强密码）
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

# 数据库主机
MYSQL_HOST=127.0.0.1

# 数据库端口（后端应用连接用）
MYSQL_PORT=3307

# 宿主机映射端口（Docker 端口映射用）
MYSQL_HOST_PORT=3307

# 本地前端笔记导入，仅 development 生效；production 会强制关闭。
NOTE_BROWSER_IMPORT_ENABLED=True
NOTE_UPLOAD_MAX_BYTES=8388608

# =====================================================================
# 前端公开配置
# 注意：NEXT_PUBLIC_* 变量会打包进前端代码，禁止放入任何 API Token
# =====================================================================

# 站点地址
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 后端 API 基础地址
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# =====================================================================
# 可选数据源配置（仅由 Django 后端使用，禁止暴露给浏览器）
# =====================================================================

# GitHub 公开 AI 项目发现。Token 可选，但建议配置以提高 Search API 限额。
GITHUB_TOKEN=
GITHUB_API_VERSION=2026-03-10
GITHUB_DISCOVERY_QUERY=llm
GITHUB_DISCOVERY_LOOKBACK_DAYS=30
GITHUB_DISCOVERY_MIN_STARS=20
GITHUB_DISCOVERY_SORT=stars

# Hugging Face 可按作者或搜索词读取模型/数据集；至少配置其中一项。
HUGGINGFACE_AUTHOR=
HUGGINGFACE_SEARCH=llm inference
HUGGINGFACE_TOKEN=
HUGGINGFACE_INCLUDE_DATASETS=True

# LLM API Key（从 https://platform.deepseek.com 获取）。必须填写平台生成的 ASCII Key，
# 不要填写中文说明、Markdown 链接或示例占位文字。
LLM_API_KEY=

# DeepSeek Responses API：联网搜索使用 web_search，输出使用 JSON Schema。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_FALLBACK_MODEL=deepseek-v4-flash
LLM_LOOKBACK_DAYS=7
LLM_REASONING_EFFORT=low
LLM_VERIFY_SOURCE_URLS=True

# 后端同步限制与研究主题。域名白名单用于拒绝模型生成的未知/不可信 URL。
RADAR_SYNC_LIMIT=20
RADAR_BROWSER_SYNC_ENABLED=True
RADAR_BROWSER_SYNC_COOLDOWN_SECONDS=30
EXTERNAL_HTTP_TIMEOUT_SECONDS=30
# 可选：自定义 arXiv 查询语法；留空时使用 AI_RADAR_KEYWORDS 自动构建查询。
ARXIV_SEARCH_QUERY=
AI_RADAR_KEYWORDS=speculative decoding,KV Cache,LLM serving,inference optimization,long context
AI_RADAR_ALLOWED_DOMAINS=arxiv.org,openreview.net,huggingface.co,github.com,pytorch.org,nvidia.com,research.google,deepmind.google,ai.meta.com,microsoft.com,openai.com,anthropic.com

# =====================================================================
# 生产环境占位配置（云部署前请替换为真实值）
# =====================================================================

# 站点域名
SITE_DOMAIN=blog.example.com

# Nginx 配置文件路径
NGINX_CONF=./deploy/nginx/http.conf
